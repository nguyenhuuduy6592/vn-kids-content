{
  "permissions": {
    "allow": [
      "Bash(gh auth status:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint --no-warn-ignored --quiet \"$CLAUDE_FILE_PATH\" 2>&1 || true"
          }
        ]
      }
    ]
  }
}
